# Copy to .env (gitignored) and fill in. All optional in development.

# Port the API (and, after hosting, the web app) listens on.
PORT=3000

# Single-user login. Unset = auth OFF (development only).
# Required when NODE_ENV=production.
APP_PASSPHRASE=

# Signs session cookies. Required in production, at least 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Session length in days (default 30).
SESSION_DAYS=30

# SQLite file. Default: <repo>/data/torah-study.db
DATABASE_PATH=

# Backups (npm run db:backup). Default dir: <repo>/backups, keep newest 30.
BACKUP_DIR=
BACKUP_KEEP=30

# Set when behind a reverse proxy (nginx, Caddy, Cloudflare): "true", a hop count, or an Express trust-proxy value.
TRUST_PROXY=

# NODE_ENV=production enables Secure cookies and requires the secrets above.
NODE_ENV=

# Built web app served by the API (default <repo>/apps/web/dist).
WEB_DIST=
