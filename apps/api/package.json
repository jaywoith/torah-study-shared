{
  "name": "@torah/api",
  "version": "0.5.0-rc.1",
  "private": true,
  "description": "HTTP API. The only runtime that loads the shared packages; owns generation, validation, UI strings and (later) AI calls.",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p .",
    "db:backup": "tsx scripts/backup.ts"
  },
  "dependencies": {
    "@torah/ai-rules": "*",
    "@torah/content": "*",
    "@torah/core": "*",
    "better-sqlite3": "^13.2.0",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0"
  }
}
