{
  "name": "torah-study",
  "version": "0.2.0",
  "private": true,
  "description": "Personal Torah study app: daily study, Siddur path, specialized paths, AI study coach. npm-workspaces monorepo.",
  "workspaces": [
    "packages/core",
    "packages/ai-rules",
    "packages/content",
    "apps/api"
  ],
  "scripts": {
    "dev": "npm run dev -w @torah/api",
    "start": "npm run start -w @torah/api",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run typecheck && npm run test",
    "version:bump": "node scripts/bump-version.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
